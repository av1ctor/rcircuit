type Asset = record { typ : AssetType; data : vec record { text; AssetValue } };
type AssetType = variant { Map; Npc; Object; Player };
type AssetValue = variant {
  F32 : float32;
  Map : HashMap;
  U32 : nat32;
  Vec : vec AssetValue;
  Bool : bool;
  None;
  Text : text;
};
type ControllerRequest = record {
  "principal" : principal;
  name : text;
  description : opt text;
};
type GameCost = variant { ICP : nat; USD : nat64 };
type GameCosts = record { to_play : GameCost };
type GameEndCredits = record {
  sub : vec GameEndCredits;
  title : text;
  people : vec record { text; text };
};
type GameInfo = record {
  fps : nat32;
  states : vec text;
  min_players : nat64;
  sfx_sets : vec vec record { text; GameSfx };
  maps : vec GameMap;
  name : text;
  costs : GameCosts;
  urls : GameURLs;
  description : text;
  max_players : nat64;
  version : float32;
  rewards : GameRewards;
  category : text;
  skills : vec text;
  subtitle : text;
};
type GameInfoResponse = record { info : GameInfo };
type GameMap = record {
  id : nat64;
  name : text;
  urls : GameMapUrls;
  description : text;
  version : float32;
};
type GameMapMusicUrls = record { main : text; over : text; victory : text };
type GameMapUrls = record {
  model : text;
  music : GameMapMusicUrls;
  image : text;
};
type GameRewards = record { winner : nat };
type GameSceneURLs = record { model : text; music : opt text };
type GameSfx = record {
  url : text;
  repeat : bool;
  rate : opt float32;
  detune : opt float32;
};
type GameURLs = record {
  engine_wasm : text;
  scenes : vec record { text; GameSceneURLs };
  cover : text;
  assets : text;
};
type HashMap = vec record {
  text;
  variant {
    F32 : float32;
    Map : HashMap;
    U32 : nat32;
    Vec : vec AssetValue;
    Bool : bool;
    None;
    Text : text;
  };
};
type HashMap_1 = vec record {
  text;
  variant {
    Int : int;
    Map : HashMap_1;
    Nat : nat;
    Blob : vec nat8;
    Text : text;
    Double : float64;
    Float : float32;
    Array : vec Nas1Value;
  };
};
type InitArg = record {
  controllers : vec ControllerRequest;
  asset_canister_url : text;
};
type InstanceAssetsResponse = record { assets : vec record { nat64; Asset } };
type InstancePlayer = record {
  id : principal;
  nft : InstancePlayerNft;
  state : InstancePlayerState;
  nft_col : NftCollectionMetadata;
  tensors : vec record { text; vec nat8 };
};
type InstancePlayerEntity = record {
  xp : float32;
  score : float32;
  health : float32;
};
type InstancePlayerNft = record {
  token_id : nat;
  collection_id : principal;
  props : opt Nas1Token;
};
type InstancePlayerState = record {
  xp : float32;
  obs : vec record { text; vec float32 };
  active : bool;
  last_thought : nat64;
  score : float32;
  skill : text;
  health : float32;
};
type InstanceRunRequest = record {
  seed : nat64;
  max_steps : nat64;
  slice : nat64;
  max_instructions : nat64;
};
type InstanceRunResponse = record {
  terminated : bool;
  steps : nat64;
  players : vec InstancePlayerEntity;
  won_at : opt nat64;
  won_by : opt principal;
  timedout : bool;
};
type InstanceStep = record { entities : vec nat8; events : vec nat8 };
type InstanceStepsResponse = record { steps : vec InstanceStep };
type Nas1Collection = record {
  states : vec text;
  sfx_sets : vec vec record { text; GameSfx };
  assets_canister_id : principal;
  version : float32;
  assets_url : text;
  skills : vec text;
  subtitle : text;
};
type Nas1Token = record {
  height : float32;
  model : text;
  image_url : text;
  traits : vec text;
  name : text;
  num_hidden_layers : nat64;
  extra : vec record { text; Nas1Value };
  model_url : text;
  epsilon : float32;
  radius : float32;
  hidden_layers_weights_size : vec nat64;
  sfx_set : nat64;
  steps_per_thought : nat64;
  game_props : vec record { principal; Nas1TokenGameProps };
};
type Nas1TokenGameProps = record { xp : float32 };
type Nas1Value = variant {
  Int : int;
  Map : HashMap_1;
  Nat : nat;
  Blob : vec nat8;
  Text : text;
  Double : float64;
  Float : float32;
  Array : vec Nas1Value;
};
type NftCollectionMetadata = record {
  std : NftStandard;
  desc : text;
  logo : text;
  name : text;
  nas1 : Nas1Collection;
};
type NftStandard = variant { ICRC7 };
type Pagination = record { offset : nat32; limit : nat32 };
type Result = variant { Ok : GameEndCredits; Err : text };
type Result_1 = variant { Ok : GameInfoResponse; Err : text };
type Result_2 = variant { Ok : text; Err : text };
type Result_3 = variant { Ok : InstanceAssetsResponse; Err : text };
type Result_4 = variant { Ok : InstanceStepsResponse; Err : text };
type Result_5 = variant { Ok : InstanceRunResponse; Err : text };
type Result_6 = variant { Ok; Err : text };
service : (InitArg) -> {
  game_get_end_credits : () -> (Result) query;
  game_get_info : () -> (Result_1) query;
  instance_create : (nat64, vec record { text; text }) -> (Result_2);
  instance_get_assets : (text) -> (Result_3) query;
  instance_get_steps : (text, Pagination) -> (Result_4) query;
  instance_run : (text, InstanceRunRequest) -> (Result_5);
  instance_setup : (text, vec InstancePlayer) -> (Result_6);
}
