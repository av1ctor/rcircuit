type Asset = record { typ : AssetType; data : vec record { text; AssetValue } };
type AssetType = variant { Npc; Level; Object; Player };
type AssetValue = variant {
  F32 : float32;
  U32 : nat32;
  Bool : bool;
  None;
  Text : text;
};
type ControllerRequest = record {
  "principal" : principal;
  name : text;
  description : opt text;
};
type GameInfo = record {
  min_players : nat64;
  image_url : text;
  name : text;
  engine_wasm_url : text;
  description : text;
  max_players : nat64;
  version : float32;
  assets_url : text;
  category : text;
};
type GameInfoResponse = record { info : GameInfo };
type InitArg = record {
  controllers : vec ControllerRequest;
  asset_canister_url : text;
};
type InstanceStep = record {
  terminated : bool;
  entities : vec nat8;
  events : vec nat8;
  timedout : bool;
};
type Pagination = record { offset : nat32; limit : nat32 };
type Result = variant { Ok : GameInfoResponse; Err : text };
type Result_1 = variant { Ok : text; Err : text };
type Result_2 = variant { Ok : vec record { nat64; Asset }; Err : text };
type Result_3 = variant { Ok : vec InstanceStep; Err : text };
type Result_4 = variant { Ok; Err : text };
service : (InitArg) -> {
  game_get_info : () -> (Result) query;
  instance_create : (vec record { text; text }) -> (Result_1);
  instance_get_assets : (text) -> (Result_2) query;
  instance_get_steps : (text, Pagination) -> (Result_3) query;
  instance_run : (text) -> (Result_4);
  instance_start : (text, vec principal) -> (Result_4);
}
