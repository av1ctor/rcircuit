type Asset = record { typ : AssetType; data : vec record { text; AssetValue } };
type AssetType = variant { Npc; Level; Object; Player };
type AssetValue = variant {
  F32 : float32;
  U32 : nat32;
  Bool : bool;
  None;
  Text : text;
};
type ControllerRequest = record {
  "principal" : principal;
  name : text;
  description : opt text;
};
type InitArg = record {
  controllers : vec ControllerRequest;
  asset_canister_url : text;
};
type InstanceCreateResponse = record {
  min_players : nat64;
  instance_id : text;
  max_players : nat64;
};
type InstanceStep = record {
  terminated : bool;
  entities : vec nat8;
  events : vec nat8;
  timedout : bool;
};
type Pagination = record { offset : nat32; limit : nat32 };
type Result = variant { Ok : InstanceCreateResponse; Err : text };
type Result_1 = variant { Ok : vec record { nat64; Asset }; Err : text };
type Result_2 = variant { Ok : vec InstanceStep; Err : text };
type Result_3 = variant { Ok; Err : text };
service : (InitArg) -> {
  instance_create : (vec record { text; text }) -> (Result);
  instance_get_assets : (text) -> (Result_1) query;
  instance_get_steps : (text, Pagination) -> (Result_2) query;
  instance_run : (text) -> (Result_3);
  instance_start : (text, vec principal) -> (Result_3);
}
