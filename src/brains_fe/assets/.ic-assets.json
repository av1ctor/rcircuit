[
    {
      "match": "wasm/*.wasm",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Content-Type": "application/wasm",
        "Cache-Control": "max-age=21600"
      },
      "ignore": false,
      "allow_raw_access": false
    },
    {
      "match": "maps/**/*",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "max-age=21600"
      },
      "ignore": false,
      "allow_raw_access": false
    },
    {
      "match": "models/**/*",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "max-age=21600"
      },
      "ignore": false,
      "allow_raw_access": false
    }
  ]