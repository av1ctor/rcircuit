{
  "canisters": {
    "rcircuit_be": {
      "candid": "src/rcircuit_be/rcircuit_be.did",
      "package": "rcircuit_be",
      "type": "rust",
      "optimize": "O4",
      "gzip": true,
      "declarations": {
        "bindings": ["js", "ts"]
      }
    },
    "rcircuit_fe": {
      "source": [
        "src/rcircuit_fe/assets"
      ],
      "type": "assets",
      "gzip": true,
      "declarations": {
        "bindings": ["js", "ts"]
      }
    }
  },
  "defaults": {
    "build": {
      "args": "",
      "packtool": ""
    }
  },
  "output_env_file": ".env",
  "version": 1
}