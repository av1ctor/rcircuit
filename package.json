{
  "name": "rcircuit-assets",
  "version": "0.0.1",
  "type": "module",
  "description": "Rusty Circuit game assets",
  "scripts": {
    "build": "./scripts/dev/01-build-fe.sh",
    "prebuild": "dfx generate",
    "deploy:local": "dfx deploy --network=local",
    "deploy:ic": "dfx deploy --network=ic",
    "deploy:backend:dev": "./scripts/dev/00-deploy-be.sh && npm run extract && npm run generate",
    "extract": "candid-extractor target/wasm32-unknown-unknown/release/rcircuit_be.wasm >./src/rcircuit_be/rcircuit_be.did",
    "generate": "dfx generate rcircuit_be"
  },
  "dependencies": {
  },
  "devDependencies": {
  },
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "browserslist": [
    "last 2 chrome version",
    "last 2 firefox version",
    "last 2 safari version",
    "last 2 edge version"
  ]
}
